{
    "name": "snapdragon/forumapi",
    "type": "phpbb-extension",
    "version": "1.0.0",
    "description": "phpBB 3.3 headless Forum API extension (snapdragon/forum-api) — the forum-bff backend. Registers /api/v1/snapdragon/** routes that validate the Casdoor JWT, re-derive authority server-side, and act-as-user through phpBB's own submit_post / content_visibility / group services.",
    "homepage": "https://github.com/Snapdragon-Systems/snapdragon-forum-api",
    "time": "2026-06-22",
    "keywords": ["phpbb", "extension", "api", "json", "headless", "casdoor", "jwt", "snapdragon"],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Snapdragon Systems",
            "homepage": "https://snapdragon.systems",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/installers": "~1.0 || ~2.0",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/http-foundation": ">=3.4"
    },
    "extra": {
        "display-name": "Snapdragon Forum API",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        },
        "version-check": {
            "host": "",
            "directory": "",
            "filename": ""
        }
    },
    "autoload": {
        "psr-4": {
            "snapdragon\\forumapi\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "snapdragon\\forumapi\\tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
