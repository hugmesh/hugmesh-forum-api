# HugMesh Forum API — example environment (NEVER commit real values).
#
# The deployment (hugmesh-generator specs/cluster/manifests/forum/phpbb.yaml) injects
# these as env vars / a Kubernetes Secret. They are NON-secret references (a JWKS URL and
# an issuer), kept out of the repo so one image serves every brand/domain.

# The Casdoor JWKS endpoint the extension fetches RS256 signing keys from (per-brand
# Casdoor => distinct jwks_uri). REQUIRED.
HUGMESH_JWKS_URI=https://casdoor.<domain>/.well-known/jwks

# The expected `iss` claim (the per-brand Casdoor issuer). REQUIRED.
HUGMESH_JWT_ISSUER=https://casdoor.<domain>

# The expected `aud` claim. Optional — leave empty to skip the audience check.
HUGMESH_JWT_AUDIENCE=

# Clock-skew leeway in seconds for exp/nbf/iat (default 30).
HUGMESH_JWT_LEEWAY=30

# Fallback phpBB forum_id for new topics when CreateTopic.categoryId is 0/absent.
HUGMESH_DEFAULT_FORUM_ID=2
